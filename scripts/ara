#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Existing lab installations remain usable; new checkouts bootstrap their own VM.
legacy_lima="$(dirname "$ROOT")/.cva6-host/lima/bin/limactl"
if [[ -x "$legacy_lima" && -f "$HOME/.local/share/cva6-lima/cva6/lima.yaml" ]]; then
  default_lima_home="$HOME/.local/share/cva6-lima"
  default_vm=cva6
  default_limactl="$legacy_lima"
else
  default_lima_home="$HOME/.local/share/proton-npu/lima"
  default_vm=proton-npu
  default_limactl=$(command -v limactl || true)
  default_limactl=${default_limactl:-"$ROOT/.tools/lima/bin/limactl"}
fi
export LIMA_HOME=${ARA_LIMA_HOME:-"$default_lima_home"}
LIMACTL=${ARA_LIMACTL:-"$default_limactl"}
VM=${ARA_VM:-$default_vm}
command_name=${1:-help}
if (($#)); then shift; fi
case "$command_name" in
  help|--help|-h)
    cat <<'EOF'
Usage: ./scripts/ara COMMAND [ARGS]
  vm-start / vm-stop / vm-status  Manage the Linux build VM
  shell [COMMAND...]             Enter /ara-workspace in Linux
  provision                      Install pinned tools and hardware dependencies
  doctor                         Report sources, configuration and tools
  build                          Build the two-lane CVA6 + Ara RTL simulator
  hello                          Run upstream bare-metal hello_world
  run [APP]                      Build/run an application (default: scalar_vector)
  smoke                          Run selected scalar/vector instruction tests
  wave [APP]                     Run with FST waveform recording
  matrix-unit                    Verify integer PE, tile, bus and router gates
  matrix                         Build/run scalar + vector + matrix ELF
  matrix-wave                    Run the combined ELF and record FST
  matrix-smoke                   Run scalar/vector regressions on matrix configuration
  matrix-negative                Confirm wrong results and timeouts are rejected
  latest [run|wave|fst|matrix|matrix-wave|matrix-fst|matrix-elf]
                                 Print a successful run or artifact path
EOF
    ;;
  vm-start) exec bash "$ROOT/scripts/lab/host-vm.sh" "$LIMACTL" "$VM" ;;
  vm-stop) exec "$LIMACTL" stop "$VM" ;;
  vm-status) exec "$LIMACTL" list "$VM" ;;
  latest) exec python3 "$ROOT/scripts/lab/latest.py" "${1:-run}" ;;
  shell)
    if [[ $(uname -s) == Linux ]]; then
      cd "$ROOT"
      if (($#)); then exec "$@"; else exec bash; fi
    fi
    exec "$LIMACTL" shell --workdir=/ara-workspace "$VM" "$@"
    ;;
  provision|doctor|build|hello|run|smoke|wave|matrix-unit|matrix|matrix-wave|matrix-smoke|matrix-negative)
    if [[ $(uname -s) == Linux ]]; then
      exec bash "$ROOT/scripts/lab/guest.sh" "$command_name" "$@"
    fi
    exec "$LIMACTL" shell --workdir=/ara-workspace "$VM" env NUM_JOBS="${NUM_JOBS:-4}" ARA_GCC_ROOT="${ARA_GCC_ROOT:-}" ARA_LAB_TOOLS="${ARA_LAB_TOOLS:-}" \
      bash /ara-workspace/scripts/lab/guest.sh "$command_name" "$@"
    ;;
  *) echo "Unknown command: $command_name" >&2; exit 2 ;;
esac
