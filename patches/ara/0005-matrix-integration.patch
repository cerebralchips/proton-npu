--- a/hardware/src/cva6_accel_first_pass_decoder.sv
+++ b/hardware/src/cva6_accel_first_pass_decoder.sv
@@ -20,6 +20,7 @@
     output logic              is_control_flow_instr_o
   );
 
+  logic        is_matrix;
   logic        is_rs1;
   logic        is_rs2;
   logic        is_rd;
@@ -44,6 +45,7 @@
   always_comb begin
     // Default values
     is_accel_o = 1'b0;
+    is_matrix = 1'b0;
     is_rs1   = 1'b0;
     is_rs2   = 1'b0;
     is_rd    = 1'b0;
@@ -57,6 +59,14 @@
     // Decode based on the opcode
     case (instr.i_type.opcode)
 
+`ifdef MATRIX_ENABLE
+      7'h2b: begin
+        // custom-1: no scalar sources, funct3=0, funct7 0=mzero / 1=mmacc.
+        is_matrix = instruction_i[24:12] == 13'b0 && instruction_i[31:26] == 6'b0;
+        is_accel_o = is_matrix;
+        is_rd = is_matrix;
+      end
+`endif
       // Arithmetic vector operations
       riscv::OpcodeVec: begin
         is_accel_o = 1'b1;
@@ -135,7 +145,7 @@
     instruction_o   = '0;
     illegal_instr_o = 1'b1;
 
-    if (is_accel_o && vs_i != riscv::Off) begin // trigger illegal instruction if the vector extension is turned off
+    if (is_accel_o && (is_matrix || vs_i != riscv::Off)) begin // trigger illegal instruction if the vector extension is turned off
       // TODO: Instruction going to other accelerators might need to distinguish whether the value of vs_i is needed or not.
       // Send accelerator instructions to the coprocessor
       instruction_o.fu  = ACCEL;
@@ -153,6 +163,10 @@
         5'b00000: instruction_o.op = ACCEL_OP;
       endcase
 
+`ifdef MATRIX_ENABLE
+      if (is_matrix) instruction_o.op = ACCEL_OP_MATRIX;
+`endif
+
       // Check that mstatus.FS is not OFF if we have a FP instruction for the accelerator
       illegal_instr_o = (is_vfp && (fs_i == riscv::Off)) ? 1'b1 : 1'b0;
 
